<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true">

    <!-- decorative wave along the bottom edge -->
    <com.seawave.serialcall.WaveView
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- header: logo, name, settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/settingsButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="9dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/primary_dark" />
        </LinearLayout>

        <!-- transient status message -->
        <TextView
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_message"
            android:padding="12dp"
            android:textColor="@color/primary_dark"
            android:textSize="13sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="22dp"
                android:paddingTop="8dp"
                android:paddingEnd="22dp"
                android:paddingBottom="12dp">

                <!-- ============ PAGE: HOME ============ -->
                <LinearLayout
                    android:id="@+id/pageHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <!-- total records banner -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="76dp">

                        <com.seawave.serialcall.RibbonButtonView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:ribbonKind="banner" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="32dp"
                            android:paddingBottom="9dp">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_database" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/total_records"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/totalCountText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#FFFFFF"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- serial number card -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:clipChildren="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="23dp"
                            android:background="@drawable/bg_card"
                            android:elevation="3dp"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="36dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="18dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="56dp">

                                <EditText
                                    android:id="@+id/slInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="56dp"
                                    android:background="@drawable/bg_input_field"
                                    android:hint="@string/serial_hint"
                                    android:imeOptions="actionSearch"
                                    android:importantForAutofill="no"
                                    android:inputType="number"
                                    android:maxLength="9"
                                    android:paddingStart="18dp"
                                    android:paddingEnd="52dp"
                                    android:textColor="@color/ink"
                                    android:textColorHint="#9DB3C7"
                                    android:textSize="22sp" />

                                <ImageView
                                    android:id="@+id/clearButton"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="end|center_vertical"
                                    android:layout_marginEnd="8dp"
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@string/clear_input"
                                    android:padding="10dp"
                                    android:src="@drawable/ic_close"
                                    android:tint="@color/muted"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </LinearLayout>

                        <com.seawave.serialcall.RibbonButtonView
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:layout_marginStart="-4dp"
                            android:elevation="4dp"
                            app:ribbonKind="title"
                            app:ribbonLabel="@string/enter_serial" />
                    </FrameLayout>

                    <com.seawave.serialcall.RibbonButtonView
                        android:id="@+id/searchButton"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginTop="20dp"
                        app:ribbonIcon="@drawable/ic_search"
                        app:ribbonKind="button"
                        app:ribbonLabel="@string/search" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/related_result"
                        android:textColor="@color/ink_soft"
                        android:textSize="14sp" />

                    <!-- result / status card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:elevation="2dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="26dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="26dp">

                        <ImageView
                            android:layout_width="74dp"
                            android:layout_height="74dp"
                            android:background="@drawable/bg_avatar"
                            android:importantForAccessibility="no"
                            android:padding="16dp"
                            android:src="@drawable/ic_person"
                            android:tint="@color/avatar_icon" />

                        <TextView
                            android:id="@+id/emptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:textColor="@color/ink_soft"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/emptySub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:textColor="@color/muted"
                            android:textSize="13sp" />

                        <com.seawave.serialcall.RibbonButtonView
                            android:id="@+id/importHomeButton"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="14dp"
                            android:visibility="gone"
                            app:ribbonIcon="@drawable/ic_upload"
                            app:ribbonKind="small"
                            app:ribbonLabel="@string/import_json" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ PAGE: RESULT ============ -->
                <LinearLayout
                    android:id="@+id/pageResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/backButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_arrow_back"
                                android:tint="@color/primary_dark" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/search_again"
                                android:textColor="@color/primary_dark"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/resultPosition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/muted"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="23dp"
                            android:background="@drawable/bg_card"
                            android:elevation="3dp"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingTop="34dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingBottom="12dp">

                                <ImageView
                                    android:layout_width="62dp"
                                    android:layout_height="62dp"
                                    android:background="@drawable/bg_avatar"
                                    android:importantForAccessibility="no"
                                    android:padding="14dp"
                                    android:src="@drawable/ic_person"
                                    android:tint="@color/avatar_icon" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/resultName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/ink"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/resultNo"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:textColor="@color/muted"
                                        android:textSize="14sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/slBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_sl_badge"
                                    android:paddingStart="9dp"
                                    android:paddingTop="3dp"
                                    android:paddingEnd="9dp"
                                    android:paddingBottom="3dp"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp" />
                            </LinearLayout>

        <LinearLayout
            android:id="@+id/rowMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_call"
                    android:tint="@color/icon_blue" />

                <TextView
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/mobile_number"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/valMobile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            <ImageView
                android:id="@+id/copyMobile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/copy"
                android:padding="8dp"
                android:src="@drawable/ic_copy"
                android:tint="@color/icon_blue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDivision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_building"
                    android:tint="@color/icon_blue" />

                <TextView
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/division"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/valDivision"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowUni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_school"
                    android:tint="@color/icon_blue" />

                <TextView
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/university"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/valUni"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_email"
                    android:tint="@color/icon_blue" />

                <TextView
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/email"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/valEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="normal" />
            <ImageView
                android:id="@+id/copyEmail"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/copy"
                android:padding="8dp"
                android:src="@drawable/ic_copy"
                android:tint="@color/icon_blue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_document"
                    android:tint="@color/icon_blue" />

                <TextView
                    android:layout_width="92dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:text="@string/remarks"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/valRemarks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            <ImageView
                android:id="@+id/editRemarkInline"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/edit"
                android:padding="8dp"
                android:src="@drawable/ic_edit"
                android:tint="@color/icon_blue" />
            </LinearLayout>
        </LinearLayout>

                        </LinearLayout>

                        <com.seawave.serialcall.RibbonButtonView
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:layout_marginStart="-4dp"
                            android:elevation="4dp"
                            app:ribbonKind="title"
                            app:ribbonLabel="@string/contact_info" />
                    </FrameLayout>

                    <com.seawave.serialcall.RibbonButtonView
                        android:id="@+id/callButton"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:layout_marginTop="20dp"
                        app:ribbonIcon="@drawable/ic_call"
                        app:ribbonKind="button"
                        app:ribbonLabel="@string/call_now" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.seawave.serialcall.RibbonButtonView
                            android:id="@+id/editRemarkButton"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            app:ribbonIcon="@drawable/ic_edit_square"
                            app:ribbonKind="small"
                            app:ribbonLabel="@string/add_edit_remark" />

                        <com.seawave.serialcall.RibbonButtonView
                            android:id="@+id/exportButton"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            app:ribbonIcon="@drawable/ic_download"
                            app:ribbonKind="small"
                            app:ribbonLabel="@string/export_json" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ============ PAGE: SETTINGS ============ -->
                <LinearLayout
                    android:id="@+id/pageSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/settingsBack"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_arrow_back"
                            android:tint="@color/primary_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/settings"
                            android:textColor="@color/primary_dark"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- data management card -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="23dp"
                            android:background="@drawable/bg_card"
                            android:elevation="3dp"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="36dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:id="@+id/settingsCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/settings_hint"
                                android:textColor="@color/muted"
                                android:textSize="13sp" />

                            <com.seawave.serialcall.RibbonButtonView
                                android:id="@+id/importSettingsButton"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:layout_marginTop="12dp"
                                app:ribbonIcon="@drawable/ic_upload"
                                app:ribbonKind="small"
                                app:ribbonLabel="@string/import_json"
                                app:ribbonTextSize="16sp" />

                            <com.seawave.serialcall.RibbonButtonView
                                android:id="@+id/exportSettingsButton"
                                android:layout_width="match_parent"
                                android:layout_height="64dp"
                                android:layout_marginTop="2dp"
                                app:ribbonIcon="@drawable/ic_download"
                                app:ribbonKind="small"
                                app:ribbonLabel="@string/export_json"
                                app:ribbonTextSize="16sp" />
                        </LinearLayout>

                        <com.seawave.serialcall.RibbonButtonView
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:layout_marginStart="-4dp"
                            android:elevation="4dp"
                            app:ribbonKind="title"
                            app:ribbonLabel="@string/data_management" />
                    </FrameLayout>

                    <!-- about card -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:clipChildren="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="23dp"
                            android:background="@drawable/bg_card"
                            android:elevation="3dp"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="36dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="18dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_logo" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/app_name"
                                        android:textColor="@color/ink"
                                        android:textSize="18sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/about_version"
                                        android:textColor="@color/muted"
                                        android:textSize="13sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/about_desc"
                                android:textColor="@color/ink_soft"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/developed_by"
                                android:textColor="@color/primary_dark"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.seawave.serialcall.RibbonButtonView
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:layout_marginStart="-4dp"
                            android:elevation="4dp"
                            app:ribbonKind="title"
                            app:ribbonLabel="@string/about_app" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </ScrollView>

        <!-- footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/footer_tagline"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/developed_by"
                android:textColor="@color/primary_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
