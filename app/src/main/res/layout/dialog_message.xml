<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:background="@drawable/bg_dialog"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="42dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/dialogMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.seawave.serialcall.RibbonButtonView
                    android:id="@+id/dialogNegative"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:ribbonKind="small"
                    app:ribbonLabel="@string/cancel"
                    app:ribbonLight="true"
                    app:ribbonTextSize="16sp" />

                <com.seawave.serialcall.RibbonButtonView
                    android:id="@+id/dialogPositive"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.2"
                    app:ribbonKind="small"
                    app:ribbonTextSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <com.seawave.serialcall.RibbonButtonView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="-4dp"
            app:ribbonKind="title" />
    </FrameLayout>
</FrameLayout>
