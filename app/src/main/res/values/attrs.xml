<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="RibbonButtonView">
        <attr name="ribbonLabel" format="string" />
        <attr name="ribbonIcon" format="reference" />
        <attr name="ribbonTextSize" format="dimension" />
        <attr name="ribbonLight" format="boolean" />
        <attr name="ribbonKind" format="enum">
            <enum name="button" value="0" />
            <enum name="small" value="1" />
            <enum name="title" value="2" />
            <enum name="banner" value="3" />
        </attr>
    </declare-styleable>
</resources>
